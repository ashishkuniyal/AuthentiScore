MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=authentiscore

SCAN_RETENTION_DAYS=30

SECRET_KEY=your_secure_secret_key_here

# Optional: Twitter v2 bearer token for automated Twitter/X collection.
TWITTER_BEARER_TOKEN=your_twitter_bearer_token

# Optional: Instagram credentials for richer profile data via instaloader.
INSTAGRAM_USERNAME=your_instagram_username
INSTAGRAM_PASSWORD=your_instagram_password
INSTAGRAM_SESSION_ID=your_instagram_session_id

# Apify token for advanced scraping if required
APIFY_API_TOKEN=your_apify_token

# Prevent HuggingFace from attempting network calls 
HF_HUB_OFFLINE=1
