# Database Configuration
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=authentiscore

# Authentication & Security
# Firebase Project ID for verifying JWT tokens
FIREBASE_PROJECT_ID=authentiscore-demo
# Comma-separated list of admin emails allowed to manage roles/system settings
ADMIN_EMAILS=admin@authentiscore.ai
# Secret key used for legacy internal signing (if applicable)
SECRET_KEY=change_this_to_a_secure_random_key_in_production
# Comma-separated origins allowed for Cross-Origin Resource Sharing
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Require email_verified=true for email/password sign-ups (D2: true by default, set false for local demo/testing without email provider)
REQUIRE_EMAIL_VERIFICATION=true

# Scanners & Third-Party Collectors
# Optional: Twitter/X API v2 bearer token
TWITTER_BEARER_TOKEN=
# Optional: Instagram credentials for richer profile collection via instaloader
INSTAGRAM_USERNAME=
INSTAGRAM_PASSWORD=
INSTAGRAM_SESSION_ID=
INSTALOADER_SESSION_DIR=./sessions
# Apify token for live Instagram audience sampling / scraping
APIFY_API_TOKEN=
# Whether to enrich Apify live audience profiles with deeper scrape (D6: off by default)
APIFY_ENRICH=false
# GitHub token for scanning GitHub profile metadata
GITHUB_TOKEN=

# Analysis Engine & Flags
# If false, hides simulated network/image forensic mock data (D3)
ENABLE_SIMULATED_FORENSICS=false
# Expose debug / test endpoints (keep false in production)
ENABLE_DEBUG_ENDPOINTS=false
# Data retention window in days for automated pruning (D12)
SCAN_RETENTION_DAYS=30

# Offline Hugging Face / Transformers operation
HF_HUB_OFFLINE=1
